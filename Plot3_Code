file<-"household_power_consumption.txt"
data<-read.table(file,header=TRUE,sep=";", stringsAsFactors=FALSE, dec=".")
data$Date<-as.Date(data$Date, format="%d/%m/%Y")
feb<-subset(data, subset=(Date>="2007-02-01"& Date<="2007-02-02"))
dt<-strptime(paste(feb$Date,feb$Time),"%Y-%m-%d %H:%M:%S")
feb$DateTime<-dt
sub1<-as.numeric(feb$Sub_metering_1)
sub2<-as.numeric(feb$Sub_metering_2)
sub3<-as.numeric(feb$Sub_metering_3)
dev.copy(png,file="plot3.png",height=480,width=480)
plot(dt,sub1,type="l",ylab="Energy Submetering",xlab="",xaxt="n")
axis(1,at=c(as.numeric(min(dt)),
            as.numeric(min(dt))+86400,
            as.numeric(max(dt))),
     labels=c("Thu","Fri","Sat"))
lines(dt,sub2,type="l",col="red")
lines(dt,sub3,type="l",col="blue")
legend("topright",c("Sub_metering_1","Sub_metering_2","Sub_metering_3"),
       lty=1,lwd=2.5,col=c("black","red","blue"))
dev.off()
